<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Firebattle Esports - Player & Admin System</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <script src="https://www.gstatic.com/firebasejs/9.22.2/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/9.22.2/firebase-database-compat.js"></script>
</head>
<body class="bg-slate-950 text-white font-sans min-h-screen">

  <!-- Toast Message -->
  <div id="toast" class="fixed bottom-5 right-5 z-50 hidden bg-slate-800 border border-orange-500/60 text-white px-4 py-3 rounded-xl shadow-2xl text-sm font-medium"></div>

  <!-- TOP MODE SWITCHER -->
  <header class="sticky top-0 z-40 bg-slate-900/95 backdrop-blur border-b border-slate-800 px-4 py-3">
    <div class="max-w-6xl mx-auto flex flex-wrap justify-between items-center gap-3">
      <div class="flex items-center gap-2">
        <i class="fa-solid fa-fire text-orange-500 text-xl"></i>
        <span class="font-extrabold tracking-wide text-lg text-orange-500">FIREBATTLE ESPORTS</span>
      </div>
      <div class="flex bg-slate-800 p-1 rounded-xl text-xs sm:text-sm font-bold">
        <button onclick="setMode('player')" id="mode-player" class="px-4 py-1.5 rounded-lg bg-orange-600 text-white transition">
          Player App
        </button>
        <button onclick="setMode('admin')" id="mode-admin" class="px-4 py-1.5 rounded-lg text-slate-300 hover:text-white transition">
          Admin Panel
        </button>
      </div>
    </div>
  </header>

  <!-- ==================== PLAYER SIDE APP ==================== -->
  <main id="playerView" class="max-w-5xl mx-auto p-4 pb-20 space-y-6">
    <!-- Player Auth Box -->
    <div id="playerAuthBox" class="max-w-md mx-auto bg-slate-900 border border-slate-800 p-6 rounded-2xl shadow-xl space-y-4 mt-4">
      <div class="text-center">
        <h2 class="text-xl font-extrabold text-orange-400">Player Login / Register</h2>
        <p class="text-xs text-slate-400 mt-1">10-digit mobile number thi login ya navu account banavo</p>
      </div>

      <input id="pPhone" type="tel" maxlength="10" placeholder="Mobile Number (10 digits)"
        class="w-full p-3 rounded-xl bg-slate-800 border border-slate-700 outline-none focus:border-orange-500 text-sm" />
      <input id="pPass" type="password" placeholder="Password"
        class="w-full p-3 rounded-xl bg-slate-800 border border-slate-700 outline-none focus:border-orange-500 text-sm" />
      <input id="pIgn" type="text" placeholder="In-Game Name / IGN (Register mate)"
        class="w-full p-3 rounded-xl bg-slate-800 border border-slate-700 outline-none focus:border-orange-500 text-sm" />
      <input id="pUid" type="text" placeholder="Game UID (Register mate)"
        class="w-full p-3 rounded-xl bg-slate-800 border border-slate-700 outline-none focus:border-orange-500 text-sm" />

      <div class="grid grid-cols-2 gap-3 pt-1">
        <button onclick="playerLogin()" class="bg-orange-600 hover:bg-orange-500 py-2.5 rounded-xl font-bold text-sm transition">
          Login
        </button>
        <button onclick="playerRegister()" class="bg-emerald-600 hover:bg-emerald-500 py-2.5 rounded-xl font-bold text-sm transition">
          Register
        </button>
      </div>
    </div>

    <!-- Logged-in Player Dashboard -->
    <div id="playerDashboard" class="hidden space-y-6">
      <!-- Player Profile & Wallet Bar -->
      <div class="bg-slate-900 border border-slate-800 p-4 rounded-2xl flex flex-wrap justify-between items-center gap-4">
        <div>
          <h2 id="pDisplayName" class="font-bold text-lg text-white">Player</h2>
          <p id="pDisplayMeta" class="text-xs text-slate-400">+91 • UID:</p>
        </div>
        <div class="flex items-center gap-3">
          <div class="bg-slate-800 px-4 py-2 rounded-xl border border-emerald-500/30">
            <span class="text-xs text-slate-400 block">Wallet Balance</span>
            <span id="pWallet" class="text-lg font-extrabold text-emerald-400">₹0</span>
          </div>
          <button onclick="playerLogout()" class="bg-red-500/20 hover:bg-red-500/30 text-red-400 px-3 py-2 rounded-xl text-xs font-bold">
            Logout
          </button>
        </div>
      </div>

      <!-- Player Sub-Tabs -->
      <div class="grid grid-cols-3 gap-2 bg-slate-900 p-1.5 rounded-xl border border-slate-800 text-xs sm:text-sm font-semibold">
        <button onclick="switchPlayerTab('tournaments')" id="ptab-tournaments" class="py-2 rounded-lg bg-orange-600 text-white">Tournaments</button>
        <button onclick="switchPlayerTab('wallet')" id="ptab-wallet" class="py-2 rounded-lg text-slate-400">Add / Withdraw</button>
        <button onclick="switchPlayerTab('history')" id="ptab-history" class="py-2 rounded-lg text-slate-400">My Requests</button>
      </div>

      <!-- Player Tab 1: Tournaments -->
      <div id="psec-tournaments" class="space-y-4">
        <div id="playerMatchesList" class="grid grid-cols-1 md:grid-cols-2 gap-4"></div>
      </div>

      <!-- Player Tab 2: Deposit & Withdrawal -->
      <div id="psec-wallet" class="hidden grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Deposit Card -->
        <div class="bg-slate-900 border border-slate-800 p-5 rounded-2xl space-y-3">
          <h3 class="font-bold text-emerald-400 text-base">Add Money (UPI Deposit)</h3>
          <div class="bg-slate-950 p-3 rounded-xl border border-slate-800 text-xs space-y-1">
            <p class="text-slate-400">Pay to UPI ID: <strong id="displayAdminUpi" class="text-orange-400 font-mono">Loading...</strong></p>
            <p class="text-slate-400">Receiver Name: <strong id="displayAdminUpiName" class="text-slate-200">Loading...</strong></p>
          </div>
          <input id="depAmount" type="number" min="1" placeholder="Amount (₹)"
            class="w-full p-3 rounded-xl bg-slate-800 border border-slate-700 outline-none text-sm" />
          <input id="depUtr" type="text" placeholder="12-digit UTR / Ref Number"
            class="w-full p-3 rounded-xl bg-slate-800 border border-slate-700 outline-none text-sm" />
          <button onclick="submitDeposit()" class="w-full bg-emerald-600 hover:bg-emerald-500 py-2.5 rounded-xl font-bold text-sm">
            Submit Deposit Request
          </button>
        </div>

        <!-- Withdrawal Card -->
        <div class="bg-slate-900 border border-slate-800 p-5 rounded-2xl space-y-3">
          <h3 class="font-bold text-orange-400 text-base">Withdraw Winnings</h3>
          <input id="wdAmount" type="number" min="1" placeholder="Withdraw Amount (₹)"
            class="w-full p-3 rounded-xl bg-slate-800 border border-slate-700 outline-none text-sm" />
          <input id="wdUpi" type="text" placeholder="Your UPI ID (e.g. player@ybl)"
            class="w-full p-3 rounded-xl bg-slate-800 border border-slate-700 outline-none text-sm" />
          <button onclick="submitWithdrawal()" class="w-full bg-orange-600 hover:bg-orange-500 py-2.5 rounded-xl font-bold text-sm">
            Request Withdrawal
          </button>
        </div>
      </div>

      <!-- Player Tab 3: My Requests -->
      <div id="psec-history" class="hidden space-y-4">
        <div class="bg-slate-900 border border-slate-800 p-4 rounded-2xl space-y-2">
          <h3 class="font-bold text-sm text-emerald-400">My Deposit Requests</h3>
          <div id="myDepositsList" class="space-y-2 text-xs"></div>
        </div>
        <div class="bg-slate-900 border border-slate-800 p-4 rounded-2xl space-y-2">
          <h3 class="font-bold text-sm text-orange-400">My Withdrawal Requests</h3>
          <div id="myWithdrawalsList" class="space-y-2 text-xs"></div>
        </div>
      </div>
    </div>
  </main>

  <!-- ==================== ADMIN PANEL ==================== -->
  <section id="adminView" class="hidden max-w-5xl mx-auto p-4 pb-20">
    <!-- Admin Login -->
    <div id="adminLoginBox" class="max-w-md mx-auto bg-slate-900 border border-orange-500/30 p-6 rounded-2xl shadow-2xl mt-4">
      <div class="text-center mb-5">
        <h2 class="text-2xl font-extrabold text-orange-500">ADMIN CONTROL</h2>
        <p class="text-slate-400 text-xs mt-1">Owner Login Panel</p>
      </div>
      <div class="space-y-3">
        <input id="adminPhone" type="tel" maxlength="10" placeholder="Admin 10-digit Mobile"
          class="w-full p-3 rounded-xl bg-slate-800 border border-slate-700 outline-none text-sm" />
        <input id="adminPass" type="password" placeholder="Admin Password"
          class="w-full p-3 rounded-xl bg-slate-800 border border-slate-700 outline-none text-sm" />
        <button onclick="loginAdmin()" class="w-full bg-orange-600 hover:bg-orange-500 py-3 rounded-xl font-bold text-sm">
          LOGIN TO ADMIN PANEL
        </button>
      </div>
    </div>

    <!-- Admin Dashboard -->
    <div id="adminDashboard" class="hidden space-y-6">
      <div class="flex justify-between items-center bg-slate-900 p-4 rounded-2xl border border-slate-800">
        <div>
          <h2 class="text-lg font-bold text-orange-500"><i class="fa-solid fa-shield-halved mr-2"></i>Owner Control Panel</h2>
          <p class="text-xs text-emerald-400">● Live Connected to Firebase</p>
        </div>
        <button onclick="logoutAdmin()" class="bg-red-500/20 text-red-400 px-3 py-1.5 rounded-lg text-xs font-bold">Logout</button>
      </div>

      <!-- Admin Tabs -->
      <div class="grid grid-cols-5 gap-1.5 bg-slate-900 p-1.5 rounded-xl border border-slate-800 text-xs font-semibold">
        <button onclick="switchAdminTab('matches')" id="atab-matches" class="py-2 rounded-lg bg-orange-600 text-white">Matches</button>
        <button onclick="switchAdminTab('deposits')" id="atab-deposits" class="py-2 rounded-lg text-slate-400">Deposits</button>
        <button onclick="switchAdminTab('withdrawals')" id="atab-withdrawals" class="py-2 rounded-lg text-slate-400">Withdrawals</button>
        <button onclick="switchAdminTab('users')" id="atab-users" class="py-2 rounded-lg text-slate-400">Players</button>
        <button onclick="switchAdminTab('settings')" id="atab-settings" class="py-2 rounded-lg text-slate-400">Settings</button>
      </div>

      <!-- Admin Tab 1: Matches -->
      <div id="asec-matches" class="space-y-5">
        <div class="bg-slate-900 p-5 rounded-2xl border border-slate-800">
          <h3 class="font-bold text-base mb-3 text-orange-400">+ Create New Tournament</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
            <input id="mTitle" type="text" placeholder="Match Title (e.g. Solo Bermuda #1)" class="p-3 rounded-xl bg-slate-800 border border-slate-700" />
            <select id="mGame" class="p-3 rounded-xl bg-slate-800 border border-slate-700">
              <option value="Free Fire MAX">Free Fire MAX</option>
              <option value="BGMI">BGMI</option>
            </select>
            <input id="mTime" type="text" placeholder="Time (e.g. Today 8:30 PM)" class="p-3 rounded-xl bg-slate-800 border border-slate-700" />
            <input id="mMap" type="text" placeholder="Map (e.g. Bermuda / Erangel)" class="p-3 rounded-xl bg-slate-800 border border-slate-700" />
            <input id="mEntry" type="number" min="0" placeholder="Entry Fee (₹)" class="p-3 rounded-xl bg-slate-800 border border-slate-700" />
            <input id="mPerKill" type="number" min="0" placeholder="Per Kill (₹)" class="p-3 rounded-xl bg-slate-800 border border-slate-700" />
            <input id="mPrize" type="number" min="0" placeholder="Prize Pool (₹)" class="p-3 rounded-xl bg-slate-800 border border-slate-700" />
            <input id="mSlots" type="number" min="2" placeholder="Total Slots (e.g. 48)" class="p-3 rounded-xl bg-slate-800 border border-slate-700" />
          </div>
          <button onclick="createMatch()" class="mt-4 w-full bg-orange-600 hover:bg-orange-500 py-3 rounded-xl font-bold text-sm">
            PUBLISH MATCH LIVE
          </button>
        </div>
        <div id="adminMatchesList" class="space-y-4"></div>
      </div>

      <!-- Admin Tab 2: Deposits -->
      <div id="asec-deposits" class="hidden space-y-3">
        <h3 class="font-bold text-base text-orange-400">UPI Deposit Requests</h3>
        <div id="adminDepositsList" class="space-y-3"></div>
      </div>

      <!-- Admin Tab 3: Withdrawals -->
      <div id="asec-withdrawals" class="hidden space-y-3">
        <h3 class="font-bold text-base text-orange-400">Player Withdrawal Requests</h3>
        <div id="adminWithdrawalsList" class="space-y-3"></div>
      </div>

      <!-- Admin Tab 4: Users -->
      <div id="asec-users" class="hidden space-y-3">
        <h3 class="font-bold text-base text-orange-400">Registered Players</h3>
        <div id="adminUsersList" class="space-y-3"></div>
      </div>

      <!-- Admin Tab 5: Settings -->
      <div id="asec-settings" class="hidden bg-slate-900 p-5 rounded-2xl border border-slate-800 space-y-4">
        <h3 class="font-bold text-base text-orange-400">UPI & Admin Credentials</h3>
        <div>
          <label class="text-xs text-slate-400">Your UPI ID</label>
          <input id="setUpiId" type="text" class="w-full mt-1 p-3 rounded-xl bg-slate-800 border border-slate-700" />
        </div>
        <div>
          <label class="text-xs text-slate-400">Receiver Name</label>
          <input id="setUpiName" type="text" class="w-full mt-1 p-3 rounded-xl bg-slate-800 border border-slate-700" />
        </div>
        <div>
          <label class="text-xs text-slate-400">Admin Phone (10-digit)</label>
          <input id="setAdminPhone" type="tel" maxlength="10" class="w-full mt-1 p-3 rounded-xl bg-slate-800 border border-slate-700" />
        </div>
        <div>
          <label class="text-xs text-slate-400">Admin Password</label>
          <input id="setAdminPass" type="text" class="w-full mt-1 p-3 rounded-xl bg-slate-800 border border-slate-700" />
        </div>
        <button onclick="saveSettings()" class="w-full bg-emerald-600 hover:bg-emerald-500 py-3 rounded-xl font-bold text-sm">
          SAVE SETTINGS TO FIREBASE
        </button>
      </div>
    </div>
  </section>

  <script>
    // 🔥 PASTE YOUR REAL FIREBASE CONFIG HERE 🔥
    const firebaseConfig = {
      apiKey: "YOUR_API_KEY",
      authDomain: "YOUR_PROJECT.firebaseapp.com",
      databaseURL: "https://YOUR_PROJECT-default-rtdb.firebaseio.com",
      projectId: "YOUR_PROJECT",
      storageBucket: "YOUR_PROJECT.appspot.com",
      messagingSenderId: "YOUR_SENDER_ID",
      appId: "YOUR_APP_ID"
    };

    firebase.initializeApp(firebaseConfig);
    const db = firebase.database();

    let currentPlayerPhone = sessionStorage.getItem('fb_player_phone') || null;
    let currentPlayerData = null;
    let latestSettings = { upiId: "firebattle@upi", upiName: "Firebattle Esports" };

    function showToast(msg) {
      const el = document.getElementById('toast');
      el.textContent = msg;
      el.classList.remove('hidden');
      clearTimeout(window.__toastTimer);
      window.__toastTimer = setTimeout(() => el.classList.add('hidden'), 2800);
    }

    function escapeHtml(str) {
      return String(str ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function setMode(mode) {
      const isPlayer = mode === 'player';
      document.getElementById('playerView').classList.toggle('hidden', !isPlayer);
      document.getElementById('adminView').classList.toggle('hidden', isPlayer);
      document.getElementById('mode-player').className = isPlayer
        ? "px-4 py-1.5 rounded-lg bg-orange-600 text-white transition"
        : "px-4 py-1.5 rounded-lg text-slate-300 hover:text-white transition";
      document.getElementById('mode-admin').className = !isPlayer
        ? "px-4 py-1.5 rounded-lg bg-orange-600 text-white transition"
        : "px-4 py-1.5 rounded-lg text-slate-300 hover:text-white transition";
    }

    // Default settings if missing
    db.ref('settings').once('value', snap => {
      if (!snap.exists()) {
        db.ref('settings').set({
          adminPhone: "9876543210",
          adminPass: "admin123",
          upiId: "firebattle@upi",
          upiName: "Firebattle Esports"
        });
      }
    });

    db.ref('settings').on('value', snap => {
      const s = snap.val();
      if (s) {
        latestSettings = s;
        document.getElementById('displayAdminUpi').textContent = s.upiId || 'Not Set';
        document.getElementById('displayAdminUpiName').textContent = s.upiName || 'Not Set';
        if (document.getElementById('setUpiId')) {
          document.getElementById('setUpiId').value = s.upiId || '';
          document.getElementById('setUpiName').value = s.upiName || '';
          document.getElementById('setAdminPhone').value = s.adminPhone || '';
          document.getElementById('setAdminPass').value = s.adminPass || '';
        }
      }
    });

    // ==================== PLAYER AUTH & LOGIC ====================
    function playerRegister() {
      const phone = document.getElementById('pPhone').value.trim();
      const password = document.getElementById('pPass').value.trim();
      const ign = document.getElementById('pIgn').value.trim();
      const uid = document.getElementById('pUid').value.trim();

      if (!/^\d{10}$/.test(phone) || !password || !ign || !uid) {
        return showToast("10-digit phone, password, IGN, ane UID bharo.");
      }

      db.ref('users/' + phone).once('value', snap => {
        if (snap.exists()) {
          return showToast("Aa number par account pehla thi chhe. Login karo.");
        }
        db.ref('users/' + phone).set({
          phone, password, ign, uid, wallet: 0, createdAt: Date.now()
        }).then(() => {
          sessionStorage.setItem('fb_player_phone', phone);
          currentPlayerPhone = phone;
          initPlayerSession(phone);
          showToast("Account banavi gayu!");
        });
      });
    }

    function playerLogin() {
      const phone = document.getElementById('pPhone').value.trim();
      const password = document.getElementById('pPass').value.trim();

      if (!/^\d{10}$/.test(phone) || !password) {
        return showToast("Valid 10-digit phone ane password enter karo.");
      }

      db.ref('users/' + phone).once('value', snap => {
        const u = snap.val();
        if (!u || String(u.password) !== password) {
          return showToast("Wrong mobile number ya password!");
        }
        sessionStorage.setItem('fb_player_phone', phone);
        currentPlayerPhone = phone;
        initPlayerSession(phone);
        showToast("Login successful!");
      });
    }

    function playerLogout() {
      sessionStorage.removeItem('fb_player_phone');
      currentPlayerPhone = null;
      currentPlayerData = null;
      document.getElementById('playerDashboard').classList.add('hidden');
      document.getElementById('playerAuthBox').classList.remove('hidden');
    }

    function initPlayerSession(phone) {
      document.getElementById('playerAuthBox').classList.add('hidden');
      document.getElementById('playerDashboard').classList.remove('hidden');

      db.ref('users/' + phone).on('value', snap => {
        const u = snap.val();
        if (!u) return;
        currentPlayerData = u;
        document.getElementById('pDisplayName').textContent = u.ign || 'Player';
        document.getElementById('pDisplayMeta').textContent = `+91 ${u.phone} • UID: ${u.uid || 'N/A'}`;
        document.getElementById('pWallet').textContent = `₹${Number(u.wallet || 0)}`;
      });

      loadPlayerMatches();
      loadPlayerHistory(phone);
    }

    if (currentPlayerPhone) {
      initPlayerSession(currentPlayerPhone);
    }

    function switchPlayerTab(tab) {
      ['tournaments', 'wallet', 'history'].forEach(t => {
        document.getElementById('psec-' + t).classList.add('hidden');
        document.getElementById('ptab-' + t).className = "py-2 rounded-lg text-slate-400";
      });
      document.getElementById('psec-' + tab).classList.remove('hidden');
      document.getElementById('ptab-' + tab).className = "py-2 rounded-lg bg-orange-600 text-white";
    }

    function loadPlayerMatches() {
      db.ref('matches').on('value', snap => {
        const list = document.getElementById('playerMatchesList');
        list.innerHTML = "";
        if (!snap.exists()) {
          list.innerHTML = `<div class="bg-slate-900 p-6 rounded-2xl border border-slate-800 text-center text-slate-400 text-sm col-span-2">Koi active match nathi.</div>`;
          return;
        }

        snap.forEach(child => {
          const id = child.key;
          const m = child.val() || {};
          const joined = Number(m.joinedCount || 0);
          const total = Number(m.slots || 0);
          const alreadyJoined = m.players && currentPlayerPhone && Boolean(m.players[currentPlayerPhone]);
          const isFull = joined >= total;

          const roomBox = alreadyJoined
            ? `<div class="bg-slate-950 border border-emerald-500/30 p-3 rounded-xl text-xs space-y-1">
                 <p class="text-emerald-400 font-bold">Room Credentials</p>
                 <p class="text-slate-300">Room ID: <span class="font-mono text-orange-400">${escapeHtml(m.roomId || 'Not published yet')}</span></p>
                 <p class="text-slate-300">Password: <span class="font-mono text-orange-400">${escapeHtml(m.roomPass || 'Not published yet')}</span></p>
               </div>`
            : `<p class="text-xs text-slate-400">Room ID & Pass match join karya pachi publish thase tyare dekhase.</p>`;

          list.innerHTML += `
            <div class="bg-slate-900 border border-slate-800 p-4 rounded-2xl space-y-3">
              <div class="flex justify-between items-start">
                <div>
                  <span class="text-xs bg-orange-500/20 text-orange-400 px-2 py-0.5 rounded font-bold">${escapeHtml(m.game)}</span>
                  <h3 class="font-bold text-base mt-1">${escapeHtml(m.title)}</h3>
                  <p class="text-xs text-slate-400">${escapeHtml(m.time)} • Map: ${escapeHtml(m.map)}</p>
                </div>
                <span class="text-xs font-bold bg-slate-800 px-2.5 py-1 rounded-lg">${joined}/${total} Slots</span>
              </div>
              <div class="grid grid-cols-3 gap-2 text-center bg-slate-950 p-2.5 rounded-xl text-xs">
                <div><span class="text-slate-400 block">Entry</span><strong class="text-white">₹${Number(m.entry || 0)}</strong></div>
                <div><span class="text-slate-400 block">Per Kill</span><strong class="text-orange-400">₹${Number(m.perKill || 0)}</strong></div>
                <div><span class="text-slate-400 block">Prize Pool</span><strong class="text-emerald-400">₹${Number(m.prize || 0)}</strong></div>
              </div>
              ${roomBox}
              ${alreadyJoined
                ? `<button disabled class="w-full bg-emerald-600/30 text-emerald-300 py-2.5 rounded-xl font-bold text-xs cursor-not-allowed">Already Joined</button>`
                : isFull
                  ? `<button disabled class="w-full bg-slate-700 text-slate-400 py-2.5 rounded-xl font-bold text-xs cursor-not-allowed">Slots Full</button>`
                  : `<button onclick="joinMatch('${id}', ${Number(m.entry || 0)})" class="w-full bg-orange-600 hover:bg-orange-500 py-2.5 rounded-xl font-bold text-xs transition">Join Match (₹${Number(m.entry || 0)})</button>`
              }
            </div>`;
        });
      });
    }

    function joinMatch(matchId, entryFee) {
      if (!currentPlayerPhone || !currentPlayerData) return showToast("Pehla login karo.");

      db.ref('matches/' + matchId).once('value', mSnap => {
        const m = mSnap.val();
        if (!m) return showToast("Match malyo nahi.");
        const joined = Number(m.joinedCount || 0);
        const total = Number(m.slots || 0);
        if (joined >= total) return showToast("Slots full thai gaya chhe.");
        if (m.players && m.players[currentPlayerPhone]) return showToast("Tame pehla thi join chho.");

        const currentWallet = Number(currentPlayerData.wallet || 0);
        if (currentWallet < entryFee) return showToast("Puratu wallet balance nathi. Pehla deposit karo.");

        db.ref('users/' + currentPlayerPhone + '/wallet').transaction(curr => {
          const val = Number(curr) || 0;
          if (val < entryFee) return;
          return val - entryFee;
        }, (err, committed) => {
          if (err || !committed) return showToast("Wallet deduct thayu nahi.");

          db.ref('matches/' + matchId + '/players/' + currentPlayerPhone).set({
            phone: currentPlayerPhone,
            ign: currentPlayerData.ign,
            uid: currentPlayerData.uid,
            joinedAt: Date.now()
          });
          db.ref('matches/' + matchId + '/joinedCount').transaction(c => (Number(c) || 0) + 1);
          showToast("Match ma successfully join thai gaya!");
        });
      });
    }

    function submitDeposit() {
      if (!currentPlayerPhone) return showToast("Pehla login karo.");
      const amount = Number(document.getElementById('depAmount').value);
      const utr = document.getElementById('depUtr').value.trim();

      if (!amount || amount <= 0 || !utr) {
        return showToast("Valid amount ane UTR number enter karo.");
      }

      db.ref('deposits').push().set({
        phone: currentPlayerPhone,
        amount,
        utr,
        status: 'Pending',
        createdAt: Date.now()
      }).then(() => {
        document.getElementById('depAmount').value = "";
        document.getElementById('depUtr').value = "";
        showToast("Deposit request mokli didhi chhe.");
      });
    }

    function submitWithdrawal() {
      if (!currentPlayerPhone || !currentPlayerData) return showToast("Pehla login karo.");
      const amount = Number(document.getElementById('wdAmount').value);
      const upiId = document.getElementById('wdUpi').value.trim();

      if (!amount || amount <= 0 || !upiId) {
        return showToast("Valid amount ane UPI ID enter karo.");
      }

      db.ref('users/' + currentPlayerPhone + '/wallet').transaction(curr => {
        const val = Number(curr) || 0;
        if (val < amount) return;
        return val - amount;
      }, (err, committed) => {
        if (err || !committed) {
          return showToast("Puratu balance nathi.");
        }
        db.ref('withdrawals').push().set({
          phone: currentPlayerPhone,
          ign: currentPlayerData.ign,
          amount,
          upiId,
          status: 'Pending',
          createdAt: Date.now()
        });
        document.getElementById('wdAmount').value = "";
        document.getElementById('wdUpi').value = "";
        showToast("Withdrawal request submit thai gayi!");
      });
    }

    function loadPlayerHistory(phone) {
      db.ref('deposits').orderByChild('phone').equalTo(phone).on('value', snap => {
        const el = document.getElementById('myDepositsList');
        el.innerHTML = "";
        if (!snap.exists()) {
          el.innerHTML = `<p class="text-slate-500">Koi deposit history nathi.</p>`;
          return;
        }
        snap.forEach(c => {
          const d = c.val();
          el.innerHTML += `<div class="flex justify-between bg-slate-950 p-2.5 rounded-lg">
            <span>₹${Number(d.amount)} • UTR: ${escapeHtml(d.utr)}</span>
            <strong class="text-amber-400">${escapeHtml(d.status)}</strong>
          </div>`;
        });
      });

      db.ref('withdrawals').orderByChild('phone').equalTo(phone).on('value', snap => {
        const el = document.getElementById('myWithdrawalsList');
        el.innerHTML = "";
        if (!snap.exists()) {
          el.innerHTML = `<p class="text-slate-500">Koi withdrawal history nathi.</p>`;
          return;
        }
        snap.forEach(c => {
          const w = c.val();
          el.innerHTML += `<div class="flex justify-between bg-slate-950 p-2.5 rounded-lg">
            <span>₹${Number(w.amount)} • UPI: ${escapeHtml(w.upiId)}</span>
            <strong class="text-orange-400">${escapeHtml(w.status)}</strong>
          </div>`;
        });
      });
    }

    // ==================== ADMIN PANEL LOGIC ====================
    function loginAdmin() {
      const phone = document.getElementById('adminPhone').value.trim();
      const pass = document.getElementById('adminPass').value.trim();
      db.ref('settings').once('value', snap => {
        const s = snap.val() || {};
        if (phone === String(s.adminPhone) && pass === String(s.adminPass)) {
          sessionStorage.setItem('fb_admin_logged', 'true');
          showAdminDashboard();
        } else {
          showToast("Wrong Admin Phone or Password!");
        }
      });
    }

    function logoutAdmin() {
      sessionStorage.removeItem('fb_admin_logged');
      location.reload();
    }

    if (sessionStorage.getItem('fb_admin_logged') === 'true') {
      showAdminDashboard();
    }

    function showAdminDashboard() {
      document.getElementById('adminLoginBox').classList.add('hidden');
      document.getElementById('adminDashboard').classList.remove('hidden');
      loadAdminData();
    }

    function switchAdminTab(tab) {
      ['matches', 'deposits', 'withdrawals', 'users', 'settings'].forEach(t => {
        document.getElementById('asec-' + t).classList.add('hidden');
        document.getElementById('atab-' + t).className = "py-2 rounded-lg text-slate-400";
      });
      document.getElementById('asec-' + tab).classList.remove('hidden');
      document.getElementById('atab-' + tab).className = "py-2 rounded-lg bg-orange-600 text-white";
    }

    function createMatch() {
      const title = document.getElementById('mTitle').value.trim();
      const game = document.getElementById('mGame').value;
      const time = document.getElementById('mTime').value.trim();
      const map = document.getElementById('mMap').value.trim() || "Standard";
      const entry = Math.max(0, Number(document.getElementById('mEntry').value) || 0);
      const perKill = Math.max(0, Number(document.getElementById('mPerKill').value) || 0);
      const prize = Math.max(0, Number(document.getElementById('mPrize').value) || 0);
      const slots = Number(document.getElementById('mSlots').value);

      if (!title || !time || !slots || slots < 2) {
        return showToast("Match title, time, ane valid slots (2+) bharo.");
      }

      db.ref('matches').push().set({
        title, game, time, map, entry, perKill, prize, slots,
        joinedCount: 0, roomId: "", roomPass: "", createdAt: Date.now()
      }).then(() => {
        showToast("Match Published Live!");
        ['mTitle', 'mTime', 'mMap', 'mEntry', 'mPerKill', 'mPrize', 'mSlots'].forEach(id => {
          document.getElementById(id).value = "";
        });
      });
    }

    function updateRoom(matchId) {
      const roomId = document.getElementById('rid-' + matchId).value.trim();
      const roomPass = document.getElementById('rpass-' + matchId).value.trim();
      db.ref('matches/' + matchId).update({ roomId, roomPass }).then(() => {
        showToast("Room ID & Password updated!");
      });
    }

    function deleteMatch(matchId) {
      if (confirm("Aa match delete karvo chhe?")) {
        db.ref('matches/' + matchId).remove().then(() => showToast("Match deleted."));
      }
    }

    function approveDeposit(depId, phone, amount) {
      const amt = Number(amount);
      db.ref('deposits/' + depId).once('value', snap => {
        const dep = snap.val();
        if (!dep || dep.status !== 'Pending') return showToast("Already processed.");
        db.ref('deposits/' + depId).update({ status: 'Approved' }).then(() => {
          return db.ref('users/' + phone + '/wallet').transaction(curr => (Number(curr) || 0) + amt);
        }).then(() => showToast(`₹${amt} added to ${phone}!`));
      });
    }

    function rejectDeposit(depId) {
      db.ref('deposits/' + depId).once('value', snap => {
        const dep = snap.val();
        if (!dep || dep.status !== 'Pending') return showToast("Already processed.");
        db.ref('deposits/' + depId).update({ status: 'Rejected' }).then(() => showToast("Deposit rejected."));
      });
    }

    function approveWithdrawal(wdId) {
      db.ref('withdrawals/' + wdId).once('value', snap => {
        const wd = snap.val();
        if (!wd || wd.status !== 'Pending') return showToast("Already processed.");
        db.ref('withdrawals/' + wdId).update({ status: 'Paid' }).then(() => {
          showToast("Withdrawal marked as Paid!");
        });
      });
    }

    function rejectWithdrawal(wdId, phone, amount) {
      const amt = Number(amount);
      db.ref('withdrawals/' + wdId).once('value', snap => {
        const wd = snap.val();
        if (!wd || wd.status !== 'Pending') return showToast("Already processed.");
        db.ref('withdrawals/' + wdId).update({ status: 'Rejected' }).then(() => {
          return db.ref('users/' + phone + '/wallet').transaction(curr => (Number(curr) || 0) + amt);
        }).then(() => showToast(`₹${amt} refunded to ${phone}'s wallet!`));
      });
    }

    function updateUserWallet(phone) {
      const raw = prompt("Amount add karva number lakho (deduct mate -50 jevu lakho):");
      if (raw === null) return;
      const amt = Number(raw.trim());
      if (isNaN(amt) || amt === 0) return showToast("Valid number lakho.");
      db.ref('users/' + phone + '/wallet').transaction(curr => Math.max(0, (Number(curr) || 0) + amt)).then(() => {
        showToast("Wallet balance updated!");
      });
    }

    function saveSettings() {
      const upiId = document.getElementById('setUpiId').value.trim();
      const upiName = document.getElementById('setUpiName').value.trim();
      const adminPhone = document.getElementById('setAdminPhone').value.trim();
      const adminPass = document.getElementById('setAdminPass').value.trim();
      if (!upiId || !adminPhone || !adminPass) return showToast("Badhi required fields bharo.");
      db.ref('settings').set({ upiId, upiName, adminPhone, adminPass }).then(() => showToast("Settings saved!"));
    }

    function loadAdminData() {
      db.ref('matches').on('value', snap => {
        const list = document.getElementById('adminMatchesList');
        list.innerHTML = "";
        if (!snap.exists()) {
          list.innerHTML = `<div class="bg-slate-900 p-5 rounded-2xl border border-slate-800 text-center text-slate-400 text-sm">Koi match nathi.</div>`;
          return;
        }
        snap.forEach(child => {
          const id = child.key;
          const m = child.val() || {};
          const playersList = m.players
            ? Object.values(m.players).map(p => `${escapeHtml(p.ign)} (${escapeHtml(p.phone)})`).join(', ')
            : 'No players yet';
          list.innerHTML += `
            <div class="bg-slate-900 p-4 rounded-2xl border border-slate-800 space-y-3">
              <div class="flex justify-between items-start">
                <div>
                  <span class="text-xs bg-orange-500/20 text-orange-400 px-2 py-0.5 rounded font-bold">${escapeHtml(m.game)}</span>
                  <h4 class="font-bold text-base mt-1">${escapeHtml(m.title)}</h4>
                  <p class="text-xs text-slate-400">${escapeHtml(m.time)} • Map: ${escapeHtml(m.map)} • Entry: ₹${Number(m.entry || 0)} • Slots: ${Number(m.joinedCount || 0)}/${Number(m.slots || 0)}</p>
                </div>
                <button onclick="deleteMatch('${id}')" class="text-red-400 text-sm"><i class="fa-solid fa-trash"></i></button>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                <input id="rid-${id}" value="${escapeHtml(m.roomId || '')}" placeholder="Room ID" class="p-2.5 rounded-lg bg-slate-800 border border-slate-700 text-sm" />
                <input id="rpass-${id}" value="${escapeHtml(m.roomPass || '')}" placeholder="Room Pass" class="p-2.5 rounded-lg bg-slate-800 border border-slate-700 text-sm" />
              </div>
              <button onclick="updateRoom('${id}')" class="w-full bg-emerald-600 hover:bg-emerald-500 py-2 rounded-lg text-xs font-bold">UPDATE ROOM ID & PASSWORD</button>
              <div class="text-xs text-slate-400 bg-slate-950 p-2.5 rounded-lg"><strong>Joined:</strong> ${playersList}</div>
            </div>`;
        });
      });

      db.ref('deposits').on('value', snap => {
        const list = document.getElementById('adminDepositsList');
        list.innerHTML = "";
        if (!snap.exists()) {
          list.innerHTML = `<div class="bg-slate-900 p-5 rounded-xl border border-slate-800 text-center text-slate-400 text-sm">Koi deposit nathi.</div>`;
          return;
        }
        const items = [];
        snap.forEach(c => items.push({ id: c.key, ...c.val() }));
        items.reverse();
        items.forEach(d => {
          list.innerHTML += `
            <div class="bg-slate-900 p-4 rounded-xl border border-slate-800 flex flex-wrap justify-between items-center gap-3">
              <div>
                <p class="font-bold text-emerald-400">₹${Number(d.amount || 0)} <span class="text-xs text-slate-400">by +91 ${escapeHtml(d.phone)}</span></p>
                <p class="text-xs text-slate-300">UTR: <span class="font-mono text-orange-400">${escapeHtml(d.utr)}</span> • Status: ${escapeHtml(d.status)}</p>
              </div>
              ${d.status === 'Pending'
                ? `<div class="flex gap-2">
                     <button onclick="approveDeposit('${d.id}', '${escapeHtml(d.phone)}', ${Number(d.amount || 0)})" class="bg-emerald-600 px-3 py-1.5 rounded-lg text-xs font-bold">Approve</button>
                     <button onclick="rejectDeposit('${d.id}')" class="bg-red-600 px-3 py-1.5 rounded-lg text-xs font-bold">Reject</button>
                   </div>`
                : `<span class="text-xs font-bold px-2.5 py-1 rounded bg-slate-800">${escapeHtml(d.status)}</span>`}
            </div>`;
        });
      });

      db.ref('withdrawals').on('value', snap => {
        const list = document.getElementById('adminWithdrawalsList');
        list.innerHTML = "";
        if (!snap.exists()) {
          list.innerHTML = `<div class="bg-slate-900 p-5 rounded-xl border border-slate-800 text-center text-slate-400 text-sm">Koi withdrawal request nathi.</div>`;
          return;
        }
        const items = [];
        snap.forEach(c => items.push({ id: c.key, ...c.val() }));
        items.reverse();
        items.forEach(w => {
          list.innerHTML += `
            <div class="bg-slate-900 p-4 rounded-xl border border-slate-800 flex flex-wrap justify-between items-center gap-3">
              <div>
                <p class="font-bold text-orange-400">₹${Number(w.amount || 0)} <span class="text-xs text-slate-400">by ${escapeHtml(w.ign || '')} (+91 ${escapeHtml(w.phone)})</span></p>
                <p class="text-xs text-slate-300">UPI ID: <span class="font-mono text-emerald-400">${escapeHtml(w.upiId)}</span> • Status: ${escapeHtml(w.status)}</p>
              </div>
              ${w.status === 'Pending'
                ? `<div class="flex gap-2">
                     <button onclick="approveWithdrawal('${w.id}')" class="bg-emerald-600 px-3 py-1.5 rounded-lg text-xs font-bold">Mark Paid</button>
                     <button onclick="rejectWithdrawal('${w.id}', '${escapeHtml(w.phone)}', ${Number(w.amount || 0)})" class="bg-red-600 px-3 py-1.5 rounded-lg text-xs font-bold">Reject & Refund</button>
                   </div>`
                : `<span class="text-xs font-bold px-2.5 py-1 rounded bg-slate-800">${escapeHtml(w.status)}</span>`}
            </div>`;
        });
      });

      db.ref('users').on('value', snap => {
        const list = document.getElementById('adminUsersList');
        list.innerHTML = "";
        if (!snap.exists()) {
          list.innerHTML = `<div class="bg-slate-900 p-5 rounded-xl border border-slate-800 text-center text-slate-400 text-sm">Koi player nathi.</div>`;
          return;
        }
        snap.forEach(child => {
          const u = child.val() || {};
          const phoneKey = child.key;
          list.innerHTML += `
            <div class="bg-slate-900 p-4 rounded-xl border border-slate-800 flex justify-between items-center">
              <div>
                <p class="font-bold">${escapeHtml(u.ign || 'Player')} <span class="text-xs text-slate-400">(UID: ${escapeHtml(u.uid || 'N/A')})</span></p>
                <p class="text-xs text-slate-400">+91 ${escapeHtml(u.phone || phoneKey)}</p>
              </div>
              <div class="text-right">
                <p class="font-bold text-emerald-400">₹${Number(u.wallet || 0)}</p>
                <button onclick="updateUserWallet('${escapeHtml(phoneKey)}')" class="text-xs bg-orange-600 px-2.5 py-1 rounded mt-1 font-semibold">+/- Balance</button>
              </div>
            </div>`;
        });
      });
    }
  </script>
</body>
</html>
