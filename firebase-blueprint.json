{
  "entities": {
    "AdminMarker": {
      "title": "AdminMarker",
      "description": "Marker document granting admin privileges to the document UID.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Admin email address."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when admin access was granted."
        }
      },
      "required": ["email", "createdAt"]
    },
    "AppSettings": {
      "title": "AppSettings",
      "description": "Platform UPI payment and admin contact settings.",
      "type": "object",
      "properties": {
        "upiId": {
          "type": "string",
          "description": "Admin UPI ID shown to players for deposits."
        },
        "upiName": {
          "type": "string",
          "description": "Receiver display name shown for UPI deposits."
        },
        "adminPhone": {
          "type": "string",
          "description": "Admin 10-digit support contact phone number."
        },
        "referralBonus": {
          "type": "integer",
          "description": "Referral reward in INR credited to both referrer and invited player."
        },
        "appDownloadUrl": {
          "type": "string",
          "description": "Direct app download or website link shared inside player referral invites."
        },
        "withdrawalFeePercent": {
          "type": "integer",
          "description": "Organizer platform fee percentage (0-20) deducted from withdrawals."
        },
        "minWithdrawal": {
          "type": "integer",
          "description": "Minimum withdrawal amount in INR allowed for players."
        },
        "sponsorTitle": {
          "type": "string",
          "description": "Optional paid sponsor or partner promo banner headline."
        },
        "sponsorSubtitle": {
          "type": "string",
          "description": "Optional sponsor promo description text."
        },
        "sponsorUrl": {
          "type": "string",
          "description": "Optional sponsor target URL opened when players tap the banner."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the latest update."
        }
      },
      "required": ["upiId", "upiName", "adminPhone", "updatedAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered esports player profile and wallet balance.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the player."
        },
        "email": {
          "type": "string",
          "description": "Google account email address."
        },
        "ign": {
          "type": "string",
          "description": "Player In-Game Name."
        },
        "gameUid": {
          "type": "string",
          "description": "Player in-game numeric/alphanumeric UID."
        },
        "phone": {
          "type": "string",
          "description": "Player 10-digit mobile number."
        },
        "wallet": {
          "type": "integer",
          "description": "Wallet balance in INR."
        },
        "referralCode": {
          "type": "string",
          "description": "Unique uppercase referral invite code owned by this player."
        },
        "referredByUid": {
          "type": "string",
          "description": "Firebase Auth UID of the player who referred this user, if claimed."
        },
        "referredByCode": {
          "type": "string",
          "description": "Referral code redeemed by this user."
        },
        "referralCount": {
          "type": "integer",
          "description": "Total number of friends referred."
        },
        "referralEarnings": {
          "type": "integer",
          "description": "Total referral bonus earnings in INR."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest update."
        }
      },
      "required": ["userId", "email", "ign", "gameUid", "phone", "wallet", "createdAt", "updatedAt"]
    },
    "Match": {
      "title": "Match",
      "description": "Esports tournament match listing and room credentials.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Tournament title."
        },
        "game": {
          "type": "string",
          "enum": ["Free Fire MAX", "BGMI"],
          "description": "Game title."
        },
        "matchMode": {
          "type": "string",
          "enum": ["Custom", "Clash Squad", "Lone Wolf"],
          "description": "Esports match mode category."
        },
        "teamFormat": {
          "type": "string",
          "enum": ["1vs1", "2vs2", "4vs4", "Full Map"],
          "description": "Team size and slot format."
        },
        "matchTime": {
          "type": "string",
          "description": "Scheduled match time text."
        },
        "mapName": {
          "type": "string",
          "description": "Arena or map name."
        },
        "entry": {
          "type": "integer",
          "description": "Entry fee in INR."
        },
        "perKill": {
          "type": "integer",
          "description": "Per-kill reward in INR."
        },
        "prize": {
          "type": "integer",
          "description": "Total prize pool in INR."
        },
        "slots": {
          "type": "integer",
          "description": "Maximum total player slots."
        },
        "joinedCount": {
          "type": "integer",
          "description": "Current number of joined players."
        },
        "roomId": {
          "type": "string",
          "description": "Custom match Room ID published by admin."
        },
        "roomPass": {
          "type": "string",
          "description": "Custom match Room Password published by admin."
        },
        "status": {
          "type": "string",
          "enum": ["LIVE", "COMPLETED"],
          "description": "Match lifecycle status."
        },
        "createdBy": {
          "type": "string",
          "description": "Admin UID who created the match."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of match creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest match update."
        }
      },
      "required": ["title", "game", "matchTime", "mapName", "entry", "perKill", "prize", "slots", "joinedCount", "roomId", "roomPass", "status", "createdBy", "createdAt", "updatedAt"]
    },
    "MatchRegistration": {
      "title": "MatchRegistration",
      "description": "Player registration record linking a player to a tournament match.",
      "type": "object",
      "properties": {
        "matchId": {
          "type": "string",
          "description": "Target match document ID."
        },
        "userId": {
          "type": "string",
          "description": "Registered player Firebase Auth UID."
        },
        "ign": {
          "type": "string",
          "description": "Player IGN at join time."
        },
        "gameUid": {
          "type": "string",
          "description": "Player Game UID at join time."
        },
        "phone": {
          "type": "string",
          "description": "Player 10-digit phone at join time."
        },
        "entryPaid": {
          "type": "integer",
          "description": "Entry fee deducted from wallet."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of registration."
        }
      },
      "required": ["matchId", "userId", "ign", "gameUid", "phone", "entryPaid", "createdAt"]
    },
    "DepositRequest": {
      "title": "DepositRequest",
      "description": "Player UPI deposit verification request.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Player Firebase Auth UID."
        },
        "phone": {
          "type": "string",
          "description": "Player 10-digit mobile number."
        },
        "ign": {
          "type": "string",
          "description": "Player IGN."
        },
        "amount": {
          "type": "integer",
          "description": "Deposit amount in INR."
        },
        "utr": {
          "type": "string",
          "description": "12-digit UPI UTR or transaction reference number."
        },
        "status": {
          "type": "string",
          "enum": ["Pending", "Approved", "Rejected"],
          "description": "Approval status."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of request creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of status update."
        }
      },
      "required": ["userId", "phone", "ign", "amount", "utr", "status", "createdAt", "updatedAt"]
    },
    "WithdrawalRequest": {
      "title": "WithdrawalRequest",
      "description": "Player UPI payout withdrawal request.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Player Firebase Auth UID."
        },
        "phone": {
          "type": "string",
          "description": "Player 10-digit mobile number."
        },
        "ign": {
          "type": "string",
          "description": "Player IGN."
        },
        "amount": {
          "type": "integer",
          "description": "Gross withdrawal amount deducted from player wallet in INR."
        },
        "feeAmount": {
          "type": "integer",
          "description": "Platform fee retained by organizer in INR."
        },
        "netPayout": {
          "type": "integer",
          "description": "Net UPI payout amount sent to player after platform fee."
        },
        "upiId": {
          "type": "string",
          "description": "Player destination UPI ID."
        },
        "status": {
          "type": "string",
          "enum": ["Pending", "Paid", "Rejected"],
          "description": "Payout status."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of request creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of status update."
        }
      },
      "required": ["userId", "phone", "ign", "amount", "upiId", "status", "createdAt", "updatedAt"]
    },
    "ReferralCode": {
      "title": "ReferralCode",
      "description": "Public lookup directory mapping an uppercase referral code to its owner UID and IGN.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "Unique uppercase alphanumeric referral code."
        },
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID."
        },
        "ign": {
          "type": "string",
          "description": "Owner In-Game Name."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        }
      },
      "required": ["code", "userId", "ign", "createdAt"]
    },
    "ReferralRecord": {
      "title": "ReferralRecord",
      "description": "Immutable record of a claimed referral reward keyed by the invited user UID.",
      "type": "object",
      "properties": {
        "referredUid": {
          "type": "string",
          "description": "Invited player Firebase Auth UID."
        },
        "referredIgn": {
          "type": "string",
          "description": "Invited player IGN."
        },
        "referrerUid": {
          "type": "string",
          "description": "Referring player Firebase Auth UID."
        },
        "referrerCode": {
          "type": "string",
          "description": "Referral code that was claimed."
        },
        "bonusAmount": {
          "type": "integer",
          "description": "Bonus INR credited to each player."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of referral claim."
        }
      },
      "required": ["referredUid", "referredIgn", "referrerUid", "referrerCode", "bonusAmount", "createdAt"]
    },
    "OwnerPayout": {
      "title": "OwnerPayout",
      "description": "Immutable organizer profit withdrawal ledger record created by an admin.",
      "type": "object",
      "properties": {
        "adminUid": {
          "type": "string",
          "description": "Firebase Auth UID of the admin who recorded the profit withdrawal."
        },
        "amount": {
          "type": "integer",
          "description": "Organizer profit amount withdrawn in INR."
        },
        "upiId": {
          "type": "string",
          "description": "Destination UPI ID for the organizer profit transfer."
        },
        "note": {
          "type": "string",
          "description": "Optional note or payout remark."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of profit withdrawal."
        }
      },
      "required": ["adminUid", "amount", "upiId", "note", "createdAt"]
    }
  },
  "firestore": {
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminMarker" },
      "description": "Admin role marker documents keyed by Firebase Auth UID."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/AppSettings" },
      "description": "Singleton platform settings document at /settings/app."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Player profile and wallet balance keyed by Firebase Auth UID."
    },
    "/referralCodes/{code}": {
      "schema": { "$ref": "#/entities/ReferralCode" },
      "description": "Referral code lookup records keyed by uppercase code."
    },
    "/referrals/{referralId}": {
      "schema": { "$ref": "#/entities/ReferralRecord" },
      "description": "Claimed referral history records keyed by referred player UID."
    },
    "/matches/{matchId}": {
      "schema": { "$ref": "#/entities/Match" },
      "description": "Esports tournament matches."
    },
    "/registrations/{regId}": {
      "schema": { "$ref": "#/entities/MatchRegistration" },
      "description": "Player match registrations keyed by {matchId}_{userId}."
    },
    "/deposits/{depositId}": {
      "schema": { "$ref": "#/entities/DepositRequest" },
      "description": "UPI deposit requests submitted by players."
    },
    "/withdrawals/{withdrawalId}": {
      "schema": { "$ref": "#/entities/WithdrawalRequest" },
      "description": "UPI withdrawal requests submitted by players."
    },
    "/ownerPayouts/{payoutId}": {
      "schema": { "$ref": "#/entities/OwnerPayout" },
      "description": "Admin-only organizer profit withdrawal ledger records."
    }
  }
}
