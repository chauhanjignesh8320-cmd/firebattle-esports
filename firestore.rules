rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email_verified == true && request.auth.token.email == 'chauhanjignesh8320@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidReferralCode(code) {
      return code is string && code.size() >= 6 && code.size() <= 16 && code.matches('^[A-Z0-9]+$');
    }

    function isValidSettings(data) {
      return data.upiId is string && data.upiId.size() >= 3 && data.upiId.size() <= 80 &&
             data.upiName is string && data.upiName.size() >= 2 && data.upiName.size() <= 60 &&
             data.adminPhone is string && data.adminPhone.matches('^[0-9]{10}$') &&
             (!('referralBonus' in data) || (data.referralBonus is int && data.referralBonus >= 0 && data.referralBonus <= 1000)) &&
             (!('appDownloadUrl' in data) || (data.appDownloadUrl is string && data.appDownloadUrl.size() <= 300 && (data.appDownloadUrl == '' || data.appDownloadUrl.matches('^https?://.*')))) &&
             (!('withdrawalFeePercent' in data) || (data.withdrawalFeePercent is int && data.withdrawalFeePercent >= 0 && data.withdrawalFeePercent <= 20)) &&
             (!('minWithdrawal' in data) || (data.minWithdrawal is int && data.minWithdrawal >= 1 && data.minWithdrawal <= 5000)) &&
             (!('sponsorTitle' in data) || (data.sponsorTitle is string && data.sponsorTitle.size() <= 100)) &&
             (!('sponsorSubtitle' in data) || (data.sponsorSubtitle is string && data.sponsorSubtitle.size() <= 180)) &&
             (!('sponsorUrl' in data) || (data.sponsorUrl is string && data.sponsorUrl.size() <= 300 && (data.sponsorUrl == '' || data.sponsorUrl.matches('^https?://.*')))) &&
             (!('depositBonusPercent' in data) || (data.depositBonusPercent is int && data.depositBonusPercent >= 0 && data.depositBonusPercent <= 100)) &&
             (!('depositOfferMinAmount' in data) || (data.depositOfferMinAmount is int && data.depositOfferMinAmount >= 0 && data.depositOfferMinAmount <= 100000)) &&
             (!('depositOfferLabel' in data) || (data.depositOfferLabel is string && data.depositOfferLabel.size() <= 80));
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.email is string && data.email.size() <= 120 &&
             data.ign is string && data.ign.size() >= 2 && data.ign.size() <= 30 &&
             data.gameUid is string && data.gameUid.size() >= 3 && data.gameUid.size() <= 30 &&
             data.phone is string && data.phone.matches('^[0-9]{10}$') &&
             data.wallet is int && data.wallet >= 0 && data.wallet <= 10000000 &&
             (!('winningBalance' in data) || (data.winningBalance is int && data.winningBalance >= 0 && data.winningBalance <= data.wallet)) &&
             (!('referralCode' in data) || data.referralCode == '' || isValidReferralCode(data.referralCode)) &&
             (!('referredByUid' in data) || (data.referredByUid is string && data.referredByUid.size() <= 128)) &&
             (!('referredByCode' in data) || data.referredByCode == '' || isValidReferralCode(data.referredByCode)) &&
             (!('referralCount' in data) || (data.referralCount is int && data.referralCount >= 0 && data.referralCount <= 100000)) &&
             (!('referralEarnings' in data) || (data.referralEarnings is int && data.referralEarnings >= 0 && data.referralEarnings <= 10000000)) &&
             (!('lastLudoRoomId' in data) || isValidId(data.lastLudoRoomId));
    }

    function isValidMatch(data) {
      return data.title is string && data.title.size() >= 2 && data.title.size() <= 80 &&
             (data.game == 'Free Fire MAX' || data.game == 'BGMI') &&
             (!('matchMode' in data) || (data.matchMode == 'Custom' || data.matchMode == 'Clash Squad' || data.matchMode == 'Lone Wolf')) &&
             (!('teamFormat' in data) || (data.teamFormat == '1vs1' || data.teamFormat == '2vs2' || data.teamFormat == '4vs4' || data.teamFormat == 'Full Map')) &&
             data.matchTime is string && data.matchTime.size() >= 2 && data.matchTime.size() <= 50 &&
             data.mapName is string && data.mapName.size() >= 2 && data.mapName.size() <= 40 &&
             data.entry is int && data.entry >= 0 && data.entry <= 100000 &&
             data.perKill is int && data.perKill >= 0 && data.perKill <= 100000 &&
             data.prize is int && data.prize >= 0 && data.prize <= 10000000 &&
             data.slots is int && data.slots >= 2 && data.slots <= 200 &&
             data.joinedCount is int && data.joinedCount >= 0 && data.joinedCount <= data.slots &&
             (!('takenSlots' in data) || (data.takenSlots is list && data.takenSlots.size() <= data.slots)) &&
             (!('rules' in data) || (data.rules is string && data.rules.size() <= 500)) &&
             data.roomId is string && data.roomPass is string &&
             data.roomId.size() <= 40 && data.roomPass.size() <= 40 &&
             (data.status == 'LIVE' || data.status == 'COMPLETED') &&
             (!('winnerSummary' in data) || (data.winnerSummary is string && data.winnerSummary.size() <= 160)) &&
             (!('totalPrizePaid' in data) || (data.totalPrizePaid is int && data.totalPrizePaid >= 0 && data.totalPrizePaid <= 10000000)) &&
             data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128;
    }

    function isValidRegistration(data) {
      return data.matchId is string && isValidId(data.matchId) &&
             data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.ign is string && data.ign.size() >= 2 && data.ign.size() <= 30 &&
             data.gameUid is string && data.gameUid.size() >= 3 && data.gameUid.size() <= 30 &&
             data.phone is string && data.phone.matches('^[0-9]{10}$') &&
             data.entryPaid is int && data.entryPaid >= 0 && data.entryPaid <= 100000 &&
             (!('slotNumber' in data) || (data.slotNumber is int && data.slotNumber >= 1 && data.slotNumber <= 200)) &&
             (!('kills' in data) || (data.kills is int && data.kills >= 0 && data.kills <= 1000)) &&
             (!('prizeWon' in data) || (data.prizeWon is int && data.prizeWon >= 0 && data.prizeWon <= 10000000)) &&
             (!('isWinner' in data) || data.isWinner is bool) &&
             (!('payoutNote' in data) || (data.payoutNote is string && data.payoutNote.size() <= 100)) &&
             (!('paidAt' in data) || data.paidAt is timestamp);
    }

    function isValidDeposit(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.phone is string && data.phone.matches('^[0-9]{10}$') &&
             data.ign is string && data.ign.size() >= 2 && data.ign.size() <= 30 &&
             data.amount is int && data.amount >= 1 && data.amount <= 100000 &&
             (!('bonusAmount' in data) || (data.bonusAmount is int && data.bonusAmount >= 0 && data.bonusAmount <= data.amount)) &&
             data.utr is string && data.utr.size() >= 6 && data.utr.size() <= 32 &&
             (data.status == 'Pending' || data.status == 'Approved' || data.status == 'Rejected');
    }

    function isValidWithdrawal(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.phone is string && data.phone.matches('^[0-9]{10}$') &&
             data.ign is string && data.ign.size() >= 2 && data.ign.size() <= 30 &&
             data.amount is int && data.amount >= 1 && data.amount <= 100000 &&
             (!('feeAmount' in data) || (data.feeAmount is int && data.feeAmount >= 0 && data.feeAmount < data.amount)) &&
             (!('netPayout' in data) || (data.netPayout is int && data.netPayout >= 1 && data.netPayout == data.amount - data.get('feeAmount', 0))) &&
             data.upiId is string && data.upiId.size() >= 3 && data.upiId.size() <= 80 &&
             (data.status == 'Pending' || data.status == 'Paid' || data.status == 'Rejected');
    }

    function isValidOwnerPayout(data) {
      return data.adminUid is string && data.adminUid.size() >= 1 && data.adminUid.size() <= 128 &&
             data.amount is int && data.amount >= 1 && data.amount <= 10000000 &&
             data.upiId is string && data.upiId.size() >= 3 && data.upiId.size() <= 80 && data.upiId.matches('^[^\\s@]+@[^\\s@]+$') &&
             data.note is string && data.note.size() <= 100;
    }

    function isValidAppInstall(data) {
      return data.installId is string && isValidId(data.installId) &&
             data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.deviceModel is string && data.deviceModel.size() >= 1 && data.deviceModel.size() <= 80 &&
             data.appVersion is string && data.appVersion.size() >= 1 && data.appVersion.size() <= 30;
    }

    function isValidLudoTokens(tokens) {
      return tokens is list &&
             tokens.size() == 4 &&
             tokens[0] is int && tokens[0] >= 0 && tokens[0] <= 57 &&
             tokens[1] is int && tokens[1] >= 0 && tokens[1] <= 57 &&
             tokens[2] is int && tokens[2] >= 0 && tokens[2] <= 57 &&
             tokens[3] is int && tokens[3] >= 0 && tokens[3] <= 57;
    }

    function isValidLudoRoom(data) {
      return data.roomCode is string && data.roomCode.size() >= 4 && data.roomCode.size() <= 12 && data.roomCode.matches('^[A-Z0-9]+$') &&
             data.hostUid is string && data.hostUid.size() >= 1 && data.hostUid.size() <= 128 &&
             data.hostIgn is string && data.hostIgn.size() >= 2 && data.hostIgn.size() <= 30 &&
             data.guestUid is string && data.guestUid.size() <= 128 &&
             data.guestIgn is string && data.guestIgn.size() <= 30 &&
             data.entry is int && data.entry >= 0 && data.entry <= 10000 &&
             data.prizePool is int && data.prizePool >= 0 && data.prizePool <= 20000 &&
             data.prizePool == (data.entry == 0 ? 0 : int((data.entry * 2 * 90) / 100)) &&
             (data.status == 'WAITING' || data.status == 'PLAYING' || data.status == 'COMPLETED' || data.status == 'CANCELLED') &&
             data.turnSlot is int && (data.turnSlot == 0 || data.turnSlot == 1) &&
             data.diceValue is int && data.diceValue >= 0 && data.diceValue <= 6 &&
             data.awaitingMove is bool &&
             data.consecutiveSixes is int && data.consecutiveSixes >= 0 && data.consecutiveSixes <= 3 &&
             isValidLudoTokens(data.hostTokens) &&
             isValidLudoTokens(data.guestTokens) &&
             data.lastAction is string && data.lastAction.size() <= 120 &&
             data.winnerUid is string && data.winnerUid.size() <= 128 &&
             data.winnerIgn is string && data.winnerIgn.size() <= 30 &&
             data.forfeitByUid is string && data.forfeitByUid.size() <= 128 &&
             data.prizePaid is bool;
    }

    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && request.auth.uid == adminUid;
      allow list, create, update, delete: if false;
    }

    match /settings/{settingId} {
      allow get: if isSignedIn() && settingId == 'app';
      allow list: if false;
      allow create: if isAdmin() &&
                       settingId == 'app' &&
                       incoming().keys().hasAll(['upiId', 'upiName', 'adminPhone', 'updatedAt']) &&
                       incoming().keys().hasOnly(['upiId', 'upiName', 'adminPhone', 'referralBonus', 'appDownloadUrl', 'withdrawalFeePercent', 'minWithdrawal', 'sponsorTitle', 'sponsorSubtitle', 'sponsorUrl', 'depositBonusPercent', 'depositOfferMinAmount', 'depositOfferLabel', 'updatedAt']) &&
                       isValidSettings(incoming()) &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time;
      allow update: if isAdmin() &&
                       settingId == 'app' &&
                       isValidSettings(incoming()) &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['upiId', 'upiName', 'adminPhone', 'referralBonus', 'appDownloadUrl', 'withdrawalFeePercent', 'minWithdrawal', 'sponsorTitle', 'sponsorSubtitle', 'sponsorUrl', 'depositBonusPercent', 'depositOfferMinAmount', 'depositOfferLabel', 'updatedAt']);
      allow delete: if false;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().wallet == 0 &&
                       incoming().get('winningBalance', 0) == 0 &&
                       incoming().get('referredByUid', '') == '' &&
                       incoming().get('referredByCode', '') == '' &&
                       incoming().get('referralCount', 0) == 0 &&
                       incoming().get('referralEarnings', 0) == 0 &&
                       incoming().keys().hasAll(['userId', 'email', 'ign', 'gameUid', 'phone', 'wallet', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'email', 'ign', 'gameUid', 'phone', 'wallet', 'winningBalance', 'referralCode', 'referredByUid', 'referredByCode', 'referralCount', 'referralEarnings', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming()) &&
                       (incoming().get('referralCode', '') == '' ||
                        existsAfter(/databases/$(database)/documents/referralCodes/$(incoming().referralCode))) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time;
      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       (
                         (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['wallet', 'winningBalance', 'ign', 'gameUid', 'phone', 'updatedAt'])) ||
                         (request.auth.uid == userId &&
                          incoming().wallet == existing().wallet &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['ign', 'gameUid', 'phone', 'updatedAt'])) ||
                         (request.auth.uid == userId &&
                          incoming().wallet >= 0 &&
                          incoming().wallet <= existing().wallet &&
                          incoming().get('winningBalance', 0) >= 0 &&
                          incoming().get('winningBalance', 0) <= existing().get('winningBalance', 0) &&
                          incoming().get('winningBalance', 0) <= incoming().wallet &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['wallet', 'winningBalance', 'updatedAt'])) ||
                         (request.auth.uid == userId &&
                          existing().get('referralCode', '') == '' &&
                          isValidReferralCode(incoming().referralCode) &&
                          incoming().wallet == existing().wallet &&
                          incoming().get('referralCount', 0) == existing().get('referralCount', 0) &&
                          incoming().get('referralEarnings', 0) == existing().get('referralEarnings', 0) &&
                          incoming().get('referredByUid', '') == existing().get('referredByUid', '') &&
                          incoming().get('referredByCode', '') == existing().get('referredByCode', '') &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['referralCode', 'referralCount', 'referralEarnings', 'referredByUid', 'referredByCode', 'updatedAt']) &&
                          existsAfter(/databases/$(database)/documents/referralCodes/$(incoming().referralCode))) ||
                         (request.auth.uid == userId &&
                          existing().get('referredByUid', '') == '' &&
                          incoming().referredByUid is string &&
                          incoming().referredByUid.size() >= 1 &&
                          incoming().referredByUid != request.auth.uid &&
                          isValidReferralCode(incoming().referredByCode) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['wallet', 'referredByUid', 'referredByCode', 'updatedAt']) &&
                          !exists(/databases/$(database)/documents/referrals/$(request.auth.uid)) &&
                          existsAfter(/databases/$(database)/documents/referrals/$(request.auth.uid)) &&
                          getAfter(/databases/$(database)/documents/referrals/$(request.auth.uid)).data.referrerUid == incoming().referredByUid &&
                          getAfter(/databases/$(database)/documents/referrals/$(request.auth.uid)).data.referrerCode == incoming().referredByCode &&
                          incoming().wallet == existing().wallet + getAfter(/databases/$(database)/documents/referrals/$(request.auth.uid)).data.bonusAmount) ||
                         (request.auth.uid != userId &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['wallet', 'referralCount', 'referralEarnings', 'updatedAt']) &&
                          !exists(/databases/$(database)/documents/referrals/$(request.auth.uid)) &&
                          existsAfter(/databases/$(database)/documents/referrals/$(request.auth.uid)) &&
                          getAfter(/databases/$(database)/documents/referrals/$(request.auth.uid)).data.referrerUid == userId &&
                          incoming().wallet == existing().wallet + getAfter(/databases/$(database)/documents/referrals/$(request.auth.uid)).data.bonusAmount &&
                          incoming().referralCount == existing().get('referralCount', 0) + 1 &&
                          incoming().referralEarnings == existing().get('referralEarnings', 0) + getAfter(/databases/$(database)/documents/referrals/$(request.auth.uid)).data.bonusAmount) ||
                         (request.auth.uid == userId &&
                          'lastLudoRoomId' in incoming() &&
                          isValidId(incoming().lastLudoRoomId) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['wallet', 'lastLudoRoomId', 'updatedAt']) &&
                          get(/databases/$(database)/documents/ludoRooms/$(incoming().lastLudoRoomId)).data.status == 'WAITING' &&
                          get(/databases/$(database)/documents/ludoRooms/$(incoming().lastLudoRoomId)).data.hostUid == userId &&
                          get(/databases/$(database)/documents/ludoRooms/$(incoming().lastLudoRoomId)).data.entry > 0 &&
                          getAfter(/databases/$(database)/documents/ludoRooms/$(incoming().lastLudoRoomId)).data.status == 'CANCELLED' &&
                          incoming().wallet == existing().wallet + get(/databases/$(database)/documents/ludoRooms/$(incoming().lastLudoRoomId)).data.entry) ||
                         ('lastLudoRoomId' in incoming() &&
                          isValidId(incoming().lastLudoRoomId) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['wallet', 'winningBalance', 'lastLudoRoomId', 'updatedAt']) &&
                          get(/databases/$(database)/documents/ludoRooms/$(incoming().lastLudoRoomId)).data.status == 'PLAYING' &&
                          get(/databases/$(database)/documents/ludoRooms/$(incoming().lastLudoRoomId)).data.prizePaid == false &&
                          get(/databases/$(database)/documents/ludoRooms/$(incoming().lastLudoRoomId)).data.prizePool > 0 &&
                          (request.auth.uid == get(/databases/$(database)/documents/ludoRooms/$(incoming().lastLudoRoomId)).data.hostUid ||
                           request.auth.uid == get(/databases/$(database)/documents/ludoRooms/$(incoming().lastLudoRoomId)).data.guestUid) &&
                          getAfter(/databases/$(database)/documents/ludoRooms/$(incoming().lastLudoRoomId)).data.status == 'COMPLETED' &&
                          getAfter(/databases/$(database)/documents/ludoRooms/$(incoming().lastLudoRoomId)).data.prizePaid == true &&
                          getAfter(/databases/$(database)/documents/ludoRooms/$(incoming().lastLudoRoomId)).data.winnerUid == userId &&
                          incoming().wallet == existing().wallet + get(/databases/$(database)/documents/ludoRooms/$(incoming().lastLudoRoomId)).data.prizePool &&
                          incoming().winningBalance == existing().get('winningBalance', 0) + get(/databases/$(database)/documents/ludoRooms/$(incoming().lastLudoRoomId)).data.prizePool)
                       );
      allow delete: if false;
    }

    match /referralCodes/{code} {
      allow get: if isSignedIn() && isValidReferralCode(code);
      allow list: if isAdmin();
      allow create: if isSignedIn() &&
                       isValidReferralCode(code) &&
                       incoming().keys().hasAll(['code', 'userId', 'ign', 'createdAt']) &&
                       incoming().keys().hasOnly(['code', 'userId', 'ign', 'createdAt']) &&
                       incoming().code == code &&
                       incoming().userId == request.auth.uid &&
                       incoming().ign is string && incoming().ign.size() >= 2 && incoming().ign.size() <= 30 &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.referralCode == code;
      allow update, delete: if false;
    }

    match /referrals/{referralId} {
      allow get: if isSignedIn() && isValidId(referralId) && (
                    isAdmin() ||
                    (resource == null && referralId == request.auth.uid) ||
                    (resource != null && (resource.data.referrerUid == request.auth.uid || resource.data.referredUid == request.auth.uid))
                  );
      allow list: if isAdmin() || (isSignedIn() && (resource.data.referrerUid == request.auth.uid || resource.data.referredUid == request.auth.uid));
      allow create: if isSignedIn() &&
                       referralId == request.auth.uid &&
                       incoming().keys().hasAll(['referredUid', 'referredIgn', 'referrerUid', 'referrerCode', 'bonusAmount', 'createdAt']) &&
                       incoming().keys().hasOnly(['referredUid', 'referredIgn', 'referrerUid', 'referrerCode', 'bonusAmount', 'createdAt']) &&
                       incoming().referredUid == request.auth.uid &&
                       incoming().referredIgn is string && incoming().referredIgn.size() >= 2 && incoming().referredIgn.size() <= 30 &&
                       incoming().referrerUid is string && incoming().referrerUid.size() >= 1 && incoming().referrerUid.size() <= 128 &&
                       incoming().referrerUid != request.auth.uid &&
                       isValidReferralCode(incoming().referrerCode) &&
                       incoming().bonusAmount is int && incoming().bonusAmount > 0 && incoming().bonusAmount <= 1000 &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       get(/databases/$(database)/documents/referralCodes/$(incoming().referrerCode)).data.userId == incoming().referrerUid &&
                       (
                         (!exists(/databases/$(database)/documents/settings/app) && incoming().bonusAmount == 10) ||
                         (exists(/databases/$(database)/documents/settings/app) && incoming().bonusAmount == get(/databases/$(database)/documents/settings/app).data.get('referralBonus', 10))
                       ) &&
                       getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.referredByUid == incoming().referrerUid &&
                       getAfter(/databases/$(database)/documents/users/$(incoming().referrerUid)).data.referralCount == get(/databases/$(database)/documents/users/$(incoming().referrerUid)).data.get('referralCount', 0) + 1;
      allow update, delete: if false;
    }

    match /matches/{matchId} {
      allow get: if isSignedIn() && isValidId(matchId);
      allow list: if isAdmin() || (isSignedIn() && (resource.data.status == 'LIVE' || resource.data.status == 'COMPLETED'));
      allow create: if isAdmin() &&
                       isValidId(matchId) &&
                       incoming().createdBy == request.auth.uid &&
                       incoming().joinedCount == 0 &&
                       (!('takenSlots' in incoming()) || incoming().takenSlots.size() == 0) &&
                       incoming().status == 'LIVE' &&
                       incoming().keys().hasAll(['title', 'game', 'matchTime', 'mapName', 'entry', 'perKill', 'prize', 'slots', 'joinedCount', 'roomId', 'roomPass', 'status', 'createdBy', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['title', 'game', 'matchMode', 'teamFormat', 'matchTime', 'mapName', 'entry', 'perKill', 'prize', 'slots', 'joinedCount', 'takenSlots', 'rules', 'roomId', 'roomPass', 'status', 'winnerSummary', 'totalPrizePaid', 'createdBy', 'createdAt', 'updatedAt']) &&
                       isValidMatch(incoming()) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time;
      allow update: if isSignedIn() &&
                       isValidId(matchId) &&
                       isValidMatch(incoming()) &&
                       incoming().createdBy == existing().createdBy &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       (
                         (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'game', 'matchMode', 'teamFormat', 'matchTime', 'mapName', 'entry', 'perKill', 'prize', 'slots', 'rules', 'roomId', 'roomPass', 'status', 'winnerSummary', 'totalPrizePaid', 'updatedAt'])) ||
                         (existing().status == 'LIVE' &&
                          incoming().joinedCount == existing().joinedCount + 1 &&
                          incoming().joinedCount <= existing().slots &&
                          existsAfter(/databases/$(database)/documents/registrations/$(matchId + '_' + request.auth.uid)) &&
                          (
                            (incoming().diff(existing()).affectedKeys().hasOnly(['joinedCount', 'takenSlots', 'updatedAt']) &&
                             getAfter(/databases/$(database)/documents/registrations/$(matchId + '_' + request.auth.uid)).data.slotNumber is int &&
                             getAfter(/databases/$(database)/documents/registrations/$(matchId + '_' + request.auth.uid)).data.slotNumber >= 1 &&
                             getAfter(/databases/$(database)/documents/registrations/$(matchId + '_' + request.auth.uid)).data.slotNumber <= existing().slots &&
                             !(getAfter(/databases/$(database)/documents/registrations/$(matchId + '_' + request.auth.uid)).data.slotNumber in existing().get('takenSlots', [])) &&
                             incoming().takenSlots is list &&
                             incoming().takenSlots.size() == existing().get('takenSlots', []).size() + 1 &&
                             incoming().takenSlots.hasAll(existing().get('takenSlots', [])) &&
                             getAfter(/databases/$(database)/documents/registrations/$(matchId + '_' + request.auth.uid)).data.slotNumber in incoming().takenSlots) ||
                            (incoming().diff(existing()).affectedKeys().hasOnly(['joinedCount', 'updatedAt']) &&
                             !('slotNumber' in getAfter(/databases/$(database)/documents/registrations/$(matchId + '_' + request.auth.uid)).data))
                          ))
                       );
      allow delete: if isAdmin() && isValidId(matchId);
    }

    match /registrations/{regId} {
      allow get: if isSignedIn() && isValidId(regId) && (
                    isAdmin() ||
                    (resource != null && resource.data.userId == request.auth.uid) ||
                    (resource == null &&
                     regId.size() > request.auth.uid.size() + 1 &&
                     regId[regId.size() - request.auth.uid.size() - 1 : regId.size()] == '_' + request.auth.uid)
                  );
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() &&
                       isValidId(regId) &&
                       regId == incoming().matchId + '_' + request.auth.uid &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['matchId', 'userId', 'ign', 'gameUid', 'phone', 'entryPaid', 'createdAt']) &&
                       incoming().keys().hasOnly(['matchId', 'userId', 'ign', 'gameUid', 'phone', 'entryPaid', 'slotNumber', 'createdAt']) &&
                       isValidRegistration(incoming()) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       exists(/databases/$(database)/documents/matches/$(incoming().matchId)) &&
                       get(/databases/$(database)/documents/matches/$(incoming().matchId)).data.status == 'LIVE' &&
                       incoming().entryPaid == get(/databases/$(database)/documents/matches/$(incoming().matchId)).data.entry &&
                       getAfter(/databases/$(database)/documents/matches/$(incoming().matchId)).data.joinedCount == get(/databases/$(database)/documents/matches/$(incoming().matchId)).data.joinedCount + 1 &&
                       (!('slotNumber' in incoming()) || (
                         incoming().slotNumber is int &&
                         incoming().slotNumber >= 1 &&
                         incoming().slotNumber <= get(/databases/$(database)/documents/matches/$(incoming().matchId)).data.slots &&
                         !(incoming().slotNumber in get(/databases/$(database)/documents/matches/$(incoming().matchId)).data.get('takenSlots', [])) &&
                         incoming().slotNumber in getAfter(/databases/$(database)/documents/matches/$(incoming().matchId)).data.get('takenSlots', [])
                       )) &&
                       (incoming().entryPaid == 0 || getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.wallet == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.wallet - incoming().entryPaid);
      allow update: if isAdmin() &&
                       isValidId(regId) &&
                       isValidRegistration(incoming()) &&
                       incoming().matchId == existing().matchId &&
                       incoming().userId == existing().userId &&
                       incoming().ign == existing().ign &&
                       incoming().gameUid == existing().gameUid &&
                       incoming().phone == existing().phone &&
                       incoming().entryPaid == existing().entryPaid &&
                       incoming().get('slotNumber', 0) == existing().get('slotNumber', 0) &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['kills', 'prizeWon', 'isWinner', 'payoutNote', 'paidAt']) &&
                       (!('paidAt' in incoming()) || (incoming().paidAt is timestamp && incoming().paidAt <= request.time));
      allow delete: if isAdmin() && isValidId(regId);
    }

    match /deposits/{depositId} {
      allow get: if isSignedIn() && isValidId(depositId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() &&
                       isValidId(depositId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().status == 'Pending' &&
                       incoming().keys().hasAll(['userId', 'phone', 'ign', 'amount', 'utr', 'status', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'phone', 'ign', 'amount', 'utr', 'status', 'createdAt', 'updatedAt']) &&
                       isValidDeposit(incoming()) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time;
      allow update: if isAdmin() &&
                       isValidId(depositId) &&
                       isValidDeposit(incoming()) &&
                       existing().status == 'Pending' &&
                       (incoming().status == 'Approved' || incoming().status == 'Rejected') &&
                       incoming().userId == existing().userId &&
                       incoming().phone == existing().phone &&
                       incoming().ign == existing().ign &&
                       incoming().amount == existing().amount &&
                       incoming().utr == existing().utr &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       (incoming().status == 'Approved' || incoming().get('bonusAmount', 0) == 0) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'bonusAmount', 'updatedAt']);
      allow delete: if false;
    }

    match /withdrawals/{withdrawalId} {
      allow get: if isSignedIn() && isValidId(withdrawalId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() &&
                       isValidId(withdrawalId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().status == 'Pending' &&
                       incoming().keys().hasAll(['userId', 'phone', 'ign', 'amount', 'upiId', 'status', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'phone', 'ign', 'amount', 'feeAmount', 'netPayout', 'upiId', 'status', 'createdAt', 'updatedAt']) &&
                       isValidWithdrawal(incoming()) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       (
                         !exists(/databases/$(database)/documents/settings/app) ||
                         (
                           incoming().amount >= get(/databases/$(database)/documents/settings/app).data.get('minWithdrawal', 1) &&
                           incoming().get('feeAmount', 0) * 100 <= incoming().amount * get(/databases/$(database)/documents/settings/app).data.get('withdrawalFeePercent', 0) &&
                           (incoming().get('feeAmount', 0) + 1) * 100 > incoming().amount * get(/databases/$(database)/documents/settings/app).data.get('withdrawalFeePercent', 0)
                         )
                       ) &&
                       get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('winningBalance', 0) >= incoming().amount &&
                       getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.wallet == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.wallet - incoming().amount &&
                       getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('winningBalance', 0) == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('winningBalance', 0) - incoming().amount;
      allow update: if isAdmin() &&
                       isValidId(withdrawalId) &&
                       isValidWithdrawal(incoming()) &&
                       existing().status == 'Pending' &&
                       (incoming().status == 'Paid' || incoming().status == 'Rejected') &&
                       incoming().userId == existing().userId &&
                       incoming().phone == existing().phone &&
                       incoming().ign == existing().ign &&
                       incoming().amount == existing().amount &&
                       incoming().get('feeAmount', 0) == existing().get('feeAmount', 0) &&
                       incoming().get('netPayout', existing().amount) == existing().get('netPayout', existing().amount) &&
                       incoming().upiId == existing().upiId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if false;
    }

    match /ownerPayouts/{payoutId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin() &&
                       isValidId(payoutId) &&
                       incoming().adminUid == request.auth.uid &&
                       incoming().keys().hasAll(['adminUid', 'amount', 'upiId', 'note', 'createdAt']) &&
                       incoming().keys().hasOnly(['adminUid', 'amount', 'upiId', 'note', 'createdAt']) &&
                       isValidOwnerPayout(incoming()) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time;
      allow update, delete: if false;
    }

    match /appInstalls/{installId} {
      allow get: if isSignedIn() && isValidId(installId) && (
                    isAdmin() ||
                    resource == null ||
                    resource.data.userId == request.auth.uid
                  );
      allow list: if isAdmin();
      allow create: if isSignedIn() &&
                       isValidId(installId) &&
                       incoming().installId == installId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['installId', 'userId', 'deviceModel', 'appVersion', 'firstSeenAt', 'lastActiveAt']) &&
                       incoming().keys().hasOnly(['installId', 'userId', 'deviceModel', 'appVersion', 'firstSeenAt', 'lastActiveAt']) &&
                       isValidAppInstall(incoming()) &&
                       incoming().firstSeenAt is timestamp && incoming().firstSeenAt <= request.time &&
                       incoming().lastActiveAt is timestamp && incoming().lastActiveAt <= request.time;
      allow update: if isSignedIn() &&
                       isValidId(installId) &&
                       existing().userId == request.auth.uid &&
                       incoming().installId == existing().installId &&
                       incoming().userId == request.auth.uid &&
                       incoming().firstSeenAt == existing().firstSeenAt &&
                       isValidAppInstall(incoming()) &&
                       incoming().lastActiveAt is timestamp && incoming().lastActiveAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['userId', 'deviceModel', 'appVersion', 'lastActiveAt']);
      allow delete: if false;
    }

    match /ludoRooms/{roomId} {
      allow get: if isSignedIn() && isValidId(roomId) && (
                    isAdmin() ||
                    resource == null ||
                    resource.data.status == 'WAITING' ||
                    resource.data.hostUid == request.auth.uid ||
                    resource.data.guestUid == request.auth.uid
                  );
      allow list: if isAdmin() || (
                    isSignedIn() && (
                      resource.data.status == 'WAITING' ||
                      resource.data.hostUid == request.auth.uid ||
                      resource.data.guestUid == request.auth.uid
                    )
                  );
      allow create: if isSignedIn() &&
                       isValidId(roomId) &&
                       incoming().hostUid == request.auth.uid &&
                       incoming().guestUid == '' &&
                       incoming().guestIgn == '' &&
                       incoming().status == 'WAITING' &&
                       incoming().turnSlot == 0 &&
                       incoming().diceValue == 0 &&
                       incoming().awaitingMove == false &&
                       incoming().consecutiveSixes == 0 &&
                       incoming().hostTokens == [0, 0, 0, 0] &&
                       incoming().guestTokens == [0, 0, 0, 0] &&
                       incoming().winnerUid == '' &&
                       incoming().winnerIgn == '' &&
                       incoming().forfeitByUid == '' &&
                       incoming().prizePaid == false &&
                       incoming().keys().hasAll(['roomCode', 'hostUid', 'hostIgn', 'guestUid', 'guestIgn', 'entry', 'prizePool', 'status', 'turnSlot', 'diceValue', 'awaitingMove', 'consecutiveSixes', 'hostTokens', 'guestTokens', 'lastAction', 'winnerUid', 'winnerIgn', 'forfeitByUid', 'prizePaid', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['roomCode', 'hostUid', 'hostIgn', 'guestUid', 'guestIgn', 'entry', 'prizePool', 'status', 'turnSlot', 'diceValue', 'awaitingMove', 'consecutiveSixes', 'hostTokens', 'guestTokens', 'lastAction', 'winnerUid', 'winnerIgn', 'forfeitByUid', 'prizePaid', 'createdAt', 'updatedAt']) &&
                       isValidLudoRoom(incoming()) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       (incoming().entry == 0 ||
                        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.wallet == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.wallet - incoming().entry);
      allow update: if isSignedIn() &&
                       isValidId(roomId) &&
                       isValidLudoRoom(incoming()) &&
                       incoming().roomCode == existing().roomCode &&
                       incoming().hostUid == existing().hostUid &&
                       incoming().hostIgn == existing().hostIgn &&
                       incoming().entry == existing().entry &&
                       incoming().prizePool == existing().prizePool &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       (
                         (existing().status == 'WAITING' &&
                          incoming().status == 'CANCELLED' &&
                          request.auth.uid == existing().hostUid &&
                          incoming().guestUid == '' &&
                          incoming().winnerUid == '' &&
                          incoming().prizePaid == false &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'lastAction', 'updatedAt']) &&
                          (existing().entry == 0 ||
                           getAfter(/databases/$(database)/documents/users/$(existing().hostUid)).data.wallet == get(/databases/$(database)/documents/users/$(existing().hostUid)).data.wallet + existing().entry)) ||
                         (existing().status == 'WAITING' &&
                          incoming().status == 'PLAYING' &&
                          request.auth.uid != existing().hostUid &&
                          incoming().guestUid == request.auth.uid &&
                          incoming().guestIgn.size() >= 2 &&
                          incoming().winnerUid == '' &&
                          incoming().prizePaid == false &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['guestUid', 'guestIgn', 'status', 'turnSlot', 'diceValue', 'awaitingMove', 'consecutiveSixes', 'lastAction', 'updatedAt']) &&
                          (existing().entry == 0 ||
                           getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.wallet == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.wallet - existing().entry)) ||
                         (existing().status == 'PLAYING' &&
                          incoming().status == 'PLAYING' &&
                          incoming().guestUid == existing().guestUid &&
                          incoming().guestIgn == existing().guestIgn &&
                          incoming().winnerUid == '' &&
                          incoming().prizePaid == false &&
                          ((existing().turnSlot == 0 && request.auth.uid == existing().hostUid) ||
                           (existing().turnSlot == 1 && request.auth.uid == existing().guestUid)) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['turnSlot', 'diceValue', 'awaitingMove', 'consecutiveSixes', 'hostTokens', 'guestTokens', 'lastAction', 'updatedAt'])) ||
                         (existing().status == 'PLAYING' &&
                          incoming().status == 'COMPLETED' &&
                          incoming().guestUid == existing().guestUid &&
                          incoming().guestIgn == existing().guestIgn &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'turnSlot', 'diceValue', 'awaitingMove', 'consecutiveSixes', 'hostTokens', 'guestTokens', 'lastAction', 'winnerUid', 'winnerIgn', 'forfeitByUid', 'prizePaid', 'updatedAt']) &&
                          (
                            (incoming().forfeitByUid == '' &&
                             ((existing().turnSlot == 0 && request.auth.uid == existing().hostUid && incoming().hostTokens == [57, 57, 57, 57] && incoming().winnerUid == existing().hostUid) ||
                              (existing().turnSlot == 1 && request.auth.uid == existing().guestUid && incoming().guestTokens == [57, 57, 57, 57] && incoming().winnerUid == existing().guestUid))) ||
                            ((request.auth.uid == existing().hostUid || request.auth.uid == existing().guestUid) &&
                             incoming().forfeitByUid == request.auth.uid &&
                             incoming().winnerUid == (request.auth.uid == existing().hostUid ? existing().guestUid : existing().hostUid))
                          ) &&
                          (
                            (existing().prizePool == 0 && incoming().prizePaid == false) ||
                            (existing().prizePool > 0 &&
                             incoming().prizePaid == true &&
                             getAfter(/databases/$(database)/documents/users/$(incoming().winnerUid)).data.wallet == get(/databases/$(database)/documents/users/$(incoming().winnerUid)).data.wallet + existing().prizePool)
                          ))
                       );
      allow delete: if false;
    }
  }
}
